# PostgreSQL existente en Dokploy. No crear otra base de datos.
# Pegar la URL completa; escapar caracteres especiales de usuario/password con URL encoding.
DATABASE_URL=
# También se admite URL_DATABASE por compatibilidad; DATABASE_URL tiene prioridad.

# URL pública del backend, sin barra final. En producción usar https://tu-dominio-api.
PUBLIC_BASE_URL=http://localhost:8000
# Orígenes del frontend separados por comas, sin barra final.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ROOT=.
HOST=localhost
PORT=8000
TIMEZONE=America/Santiago

# Generar claves propias antes de iniciar (ver README).
# Para una base existente, reutilizar ENCRYPTION_KEY original: NO regenerarla.
ENCRYPTION_KEY=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

RESEND_API_KEY=
EMAIL_ADDRESS=
CODE_TTL_MINUTES=10
CODE_LENGTH=6
MAX_ATTEMPTS=5
TEMPORARY_ACCESS_DAYS=1
MAX_VISITS_PER_USER=5
